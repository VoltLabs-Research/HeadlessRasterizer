{
  "name": "@voltstack/headless-rasterizer",
  "version": "1.1.1",
  "description": "Native Node.js addon that renders point clouds to PNG previews.",
  "private": false,
  "gypfile": true,
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "binding.gyp",
    "index.js",
    "index.d.ts",
    "src/**/*",
    "prebuilds/**/*",
    "LICENSE"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "prebuild": "prebuildify --napi --strip",
    "test": "node --test test/rasterize.test.mjs"
  },
  "devDependencies": {
    "node-gyp": "^10.0.0",
    "prebuildify": "^6.0.1"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoltLabs-Research/HeadlessRasterizer.git"
  },
  "types": "index.d.ts"
}
